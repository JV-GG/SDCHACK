# Copy this file to backend/.env for local runs, or add each value as a Replit Secret.
# Never commit the real .env file (it is git-ignored).
#
# Every value is optional: with nothing set, the app runs fully offline on local SQLite and
# uses its deterministic narrative templates. Uncomment and fill an API key to switch that AI tier on
# (the keys are commented out so copying this file unchanged keeps the app offline-safe).

# --- AI tier 1: DeepSeek cloud API ---
# DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- AI tier 2: RunPod serverless GPU (OpenAI-compatible vLLM endpoint) ---
# RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_BASE_URL=https://api.runpod.ai/v2/your-endpoint-id/openai/v1
RUNPOD_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# --- Optional Neon Postgres mirror (leave empty for local SQLite only) ---
DATABASE_URL=

# --- Background opportunity scan interval in hours (0 disables) ---
SCHEDULED_SCAN_INTERVAL_HOURS=24

# --- Frontend only: put this in frontend/.env.local if the API is not on localhost:8000 ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
