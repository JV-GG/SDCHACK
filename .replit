modules = ["python-3.11"]
entrypoint = "backend/app/main.py"
run = "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"

[deployment]
run = ["sh", "-c", "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 8000
externalPort = 80

