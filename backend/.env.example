PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000", "https://your-frontend.vercel.app"]

# ==============================================================================
# TIER 1: Primary Cloud AI (Fast 1.8s, High Stability - DeepSeek V3)
# ==============================================================================
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ==============================================================================
# TIER 2: RunPod Private Serverless GPU (Automatic Failover)
# ==============================================================================
RUNPOD_API_KEY="rpa_your_runpod_api_key_here"
RUNPOD_BASE_URL="https://api.runpod.ai/v2/reig5yleze9o5f/openai/v1"
RUNPOD_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-7B"

# ==============================================================================
# TIER 3: Optional Gemini API (Alternative)
# ==============================================================================
GEMINI_API_KEY=""
